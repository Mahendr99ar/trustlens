{
  "manifest_version": 3,
  "name": "TrustLens: AI review checker",
  "short_name": "TrustLens",
  "version": "0.1.0",
  "description": "Flags reviews that look AI-written and shows what genuine reviewers say, on Amazon product pages. Runs the model on your device.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "TrustLens", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["https://*.workers.dev/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*", "https://www.amazon.in/*", "https://www.amazon.co.uk/*", "https://www.amazon.ca/*",
        "https://www.amazon.de/*", "https://www.amazon.com.au/*", "https://www.amazon.ae/*", "https://www.amazon.sg/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
